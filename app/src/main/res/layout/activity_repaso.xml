<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F8F9FA">
    <Button
        android:id="@+id/btnVolver"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="🔙 Salir"
        android:backgroundTint="#B0BEC5"
        android:textColor="#333333"
        app:cornerRadius="12dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvContadorRepaso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tarjeta 1 / 5"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:layout_marginBottom="24dp"/>


    <LinearLayout
        android:id="@+id/tarjetaFlashcard"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:background="#FFF9C4"
        android:gravity="center"
        android:padding="24dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/tvTextoTarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando..."
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textAlignment="center"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👆 Toca la tarjeta para voltearla"
        android:textSize="16sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSiguienteTarjeta"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="Siguiente ➡️"
        android:textSize="18sp"
        android:backgroundTint="#4CAF50"
        app:cornerRadius="16dp"/>

</LinearLayout>